{
  "name": "empire-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motor visual + repositório de assets do ecossistema Empire, sobre Phaser 3. Não depende do EmpireCore nem de nenhum EmpireGame.",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --if-present run test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
