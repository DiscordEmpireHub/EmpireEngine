{
  "name": "@empire/asset-service",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor HTTP que armazena e serve os arquivos binarios de assets (imagens, sons, efeitos) do ecossistema Empire. Nao conhece preco, raridade ou propriedade - isso e responsabilidade do EmpireCore.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
